# Agent automation secrets for Nirmata. Copy to .agents/automations/.env and fill in.
# This is NOT the app's .env and NOT the server's .env. Keep it git-ignored
# (".env" and ".env.*" are ignored in this repository).

# Where the Nirmata server is reached. The helper sends only to this host.
API_BASE_URL=http://127.0.0.1:8788

# An agent token (nga_...), made in Nirmata: "Import a world" shows four once; the
# "Agent access" button on a world makes more. It belongs to one world and one author,
# expires, and can be revoked there. Never paste it into a prompt, a script or a commit.
API_TOKEN=replace-with-an-agent-token

# Nirmata expects "Authorization: Bearer nga_...", which is what these defaults send.
API_AUTH_HEADER=Authorization
API_AUTH_SCHEME=Bearer
API_TIMEOUT=30

# The routes are under /api/agent/worlds/<world>/..., listed in docs/api/agent.openapi.json:
#   python .agents/skills/api-data-automation/scripts/agent_api.py GET /api/agent/me
#
# One token per worker (characters, accessories, settings are lanes: each may write only its
# own kinds of card). Keep each in its own file named ".env.<worker>" (so it is git-ignored),
# inside an "automations" folder, and point the helper at it for that worker only:
#   .agents/automations/.env.characters
#   AGENT_AUTOMATION_ENV=.agents/automations/.env.characters
#
# On Windows in Git Bash, set MSYS_NO_PATHCONV=1 first, or "/api/agent/me" is turned into a
# file path before the helper sees it (PowerShell and cmd are not affected):
#   MSYS_NO_PATHCONV=1 python .agents/skills/api-data-automation/scripts/agent_api.py GET /api/agent/me
