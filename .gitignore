# dependencies and build output
node_modules/
dist/
build/
__pycache__/
*.pyc

# secrets - never commit
.env
.env.*
*.local.json
.agents/automation/*.env
.agents/automations/*.env

# generated / personal
apps/studio/state/**
!apps/studio/state/.gitignore
apps/studio/assets/
.cache/
*.sqlite
*.sqlite-journal
sanitized_output/
tools/twine/build/
tools/twine/reader*.html
tools/vendor/
services/rules-gatekeeper/data/dataset.jsonl
services/rules-gatekeeper/data/rule_groups.json
services/rules-gatekeeper/data/rule_scopes.json

# worlds: only the shipped scaffold and example are versioned; any other world is private (ADR-0005)
worlds/*
!worlds/_template/
!worlds/_shared/
!worlds/example-world/

# story saves are personal by default; remove this line to version them
worlds/*/stories/*
!worlds/*/stories/.gitkeep

# ComfyUI world asset workflows and feedback datasets (content-neutral)
worlds/**/assets/workflow/
worlds/**/assets/dataset/

.claude/worktrees/
supabase/migrations/

# pg driver for the human-run db tools
tools/db-deps/node_modules/
tools/db-deps/package-lock.json

# the owner's list of private terms for the neutrality check (never committed)
terms.forbidden
